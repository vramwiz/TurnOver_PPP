[
  {
    "id": "VRAMWIZ.TurnOver_PPP",
    "name": "布をめくる",
    "type": "フィルタプラグイン",
    "summary": "布の範囲を2点でつまみ、めくり・風揺れ・波打ちを加えるフィルター",
    "description": "https://raw.githubusercontent.com/vramwiz/TurnOver_PPP/main/README.md",
    "author": "VRAMの魔術師",
    "repoURL": "https://github.com/vramwiz/TurnOver_PPP",
    "licenses": [
      {
        "type": "不明",
        "isCustom": true,
        "copyrights": [],
        "licenseBody": ""
      }
    ],
    "tags": [
      "布",
      "めくり",
      "揺れ",
      "変形"
    ],
    "dependencies": [],
    "images": [],
    "installer": {
      "source": {
        "direct": null,
        "booth": null,
        "GoogleDrive": null,
        "github": {
          "owner": "vramwiz",
          "repo": "TurnOver_PPP",
          "pattern": "^TurnOver_PPP\\.zip$"
        }
      },
      "install": [
        {
          "action": "download"
        },
        {
          "action": "extract"
        },
        {
          "action": "copy",
          "from": "{tmp}/TurnOver_PPP",
          "to": "{pluginsDir}/TurnOver_PPP"
        }
      ],
      "uninstall": [
        {
          "action": "delete",
          "path": "{pluginsDir}/TurnOver_PPP"
        }
      ]
    },
    "version": []
  }
]
